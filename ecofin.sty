\cs_new_protected:Npn \__ecofin_resolve_std_authors:
  {
    \bool_if:NT \g_ecofin_used_structured_bool
      {
        \int_compare:nNnT { \seq_count:N \g_ecofin_auth_names_seq } = { 0 }
          {
            \int_step_inline:nn { \seq_count:N \g_ecofin_std_names_seq }
              {
                \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \g_ecofin_std_keys_seq {##1} }
                \bool_set_false:N \l_ecofin_auth_corr_bool
                \tl_if_in:NnT \l_tmpa_tl {*}
                  {
                    \bool_set_true:N \l_ecofin_auth_corr_bool
                    \tl_remove_all:Nn \l_tmpa_tl {*}
                    \tl_remove_all:Nn \l_tmpa_tl {,}
                    \tl_trim_spaces:N \l_tmpa_tl
                  }
                \prop_get:NVNTF \g_ecofin_affil_short_prop \l_tmpa_tl \l_tmpb_tl
                  { }
                  { \tl_clear:N \l_tmpb_tl }
                \prop_get:NVNTF \g_ecofin_affil_addr_prop \l_tmpa_tl \l_ecofin_auth_addr_tl
                  { }
                  { \tl_set_eq:NN \l_ecofin_auth_addr_tl \l_tmpb_tl }
                \tl_set:Nx \l_ecofin_auth_orcid_tl { \seq_item:Nn \g_ecofin_std_orcids_seq {##1} }
                \tl_set:Nx \l_ecofin_auth_note_tl  { \seq_item:Nn \g_ecofin_std_notes_seq  {##1} }
                \tl_set:Nx \l__ecofin_pop_tl       { \seq_item:Nn \g_ecofin_std_emails_seq {##1} }
                \tl_set:Nx \l__ecofin_std_name_tl  { \seq_item:Nn \g_ecofin_std_names_seq  {##1} }
                \use:e
                  {
                    \exp_not:N \ecofinauthor
                      [
                        \bool_if:NT \l_ecofin_auth_corr_bool { corresponding, }
                        orcid   = { \exp_not:V \l_ecofin_auth_orcid_tl },
                        note    = { \exp_not:V \l_ecofin_auth_note_tl },
                        address = { \exp_not:V \l_ecofin_auth_addr_tl }
                      ]
                      { \exp_not:V \l__ecofin_std_name_tl }
                      { \exp_not:V \l_tmpb_tl }
                      { \exp_not:V \l__ecofin_pop_tl }
                  }
              }
          }
      }
  }

% \ecofinauthor[orcid=..., corresponding, note={...}]{Name}{Institution}{email}
\NewDocumentCommand{\ecofinauthor}{O{} m m G{}}
  {
    \group_begin:
      \bool_set_false:N \l_ecofin_auth_corr_bool
      \tl_clear:N \l_ecofin_auth_orcid_tl
      \tl_clear:N \l_ecofin_auth_note_tl
      \tl_clear:N \l_ecofin_auth_addr_tl
      \keys_set:nn { ecofin/author } {#1}

      \tl_set:Nn \l_tmpa_tl {#2}
      \tl_trim_spaces:N \l_tmpa_tl
      \tl_set:Nn \l_tmpb_tl {#3}
      \tl_trim_spaces:N \l_tmpb_tl

      \tl_clear:N \l_ecofin_built_note_tl
      \bool_if:NT \l_ecofin_auth_corr_bool
        { \tl_put_right:Nn \l_ecofin_built_note_tl { Corresponding~author.~ } }
      \tl_if_empty:NF \l_ecofin_auth_note_tl
        {
          \tl_put_right:NV \l_ecofin_built_note_tl \l_ecofin_auth_note_tl
          \tl_put_right:Nn \l_ecofin_built_note_tl { .~ }
        }
      \tl_if_empty:NTF \l_ecofin_auth_addr_tl
        {
          \tl_if_empty:NF \l_tmpb_tl
            {
              \tl_put_right:NV \l_ecofin_built_note_tl \l_tmpb_tl
              \tl_put_right:Nn \l_ecofin_built_note_tl { .~ }
            }
        }
        {
          \tl_put_right:NV \l_ecofin_built_note_tl \l_ecofin_auth_addr_tl
          \tl_put_right:Nn \l_ecofin_built_note_tl { .~ }
        }
      \tl_if_blank:nF {#4}
        {
          \tl_put_right:Nn \l_ecofin_built_note_tl
            { Email:~\href{mailto:#4}{\nolinkurl{#4}}.~ }
        }
      \tl_if_empty:NF \l_ecofin_auth_orcid_tl
        {
          \tl_put_right:Nx \l_ecofin_built_note_tl
            {
              ORCID:~\exp_not:N \href
                {https://orcid.org/\tl_use:N \l_ecofin_auth_orcid_tl}
                {\exp_not:N \nolinkurl{\tl_use:N \l_ecofin_auth_orcid_tl}}.
            }
        }

      \seq_gput_right:NV \g_ecofin_auth_names_seq \l_tmpa_tl
      \seq_gput_right:NV \g_ecofin_auth_insts_seq \l_tmpb_tl
      \seq_gput_right:NV \g_ecofin_auth_notes_seq \l_ecofin_built_note_tl
    \group_end:
  }

% Footnotes of the author block are set after the block; their link targets are kept
\cs_new_protected:Npn \__ecofin_queue_fn:n #1
  {
    \tl_if_blank:nF {#1}
      {
        \footnotemark
        \cs_if_exist:NTF \Hy@footnote@currentHref
          {
            \seq_gput_right:Nx \g_ecofin_deferred_notes_seq
              {
                \exp_not:N \__ecofin_emit_fn:nnn
                  { \int_use:c { c@footnote } }
                  { \exp_not:o { \Hy@footnote@currentHref } }
                  { \exp_not:n {#1} }
              }
          }
          {
            \seq_gput_right:Nx \g_ecofin_deferred_notes_seq
              {
                \exp_not:N \__ecofin_emit_fn:nnn
                  { \int_use:c { c@footnote } }
                  { }
                  { \exp_not:n {#1} }
              }
          }
      }
  }

\cs_new_protected:Npn \__ecofin_emit_fn:nnn #1 #2 #3
  {
    \group_begin:
      \int_set:cn { c@footnote } {#1}
      \tl_if_blank:nF {#2}
        { \cs_set:Npn \Hy@footnote@currentHref {#2} }
      \footnotetext{#3}
    \group_end:
  }

\cs_new_protected:Npn \__ecofin_emit_unmarked_note:n #1
  {
    \group_begin:
      \renewcommand{\thefootnote}{}%
      \long\def\@makefntext##1{\noindent\footnotesize\setstretch{1}##1}%
      \footnotetext[0]{#1}%
    \group_end:
  }

\cs_new_protected:Npn \__ecofin_render_author_cell:nn #1 #2
  {
    \parbox[t]{#2}
      {
        \centering\setstretch{1.08}
        {\large\scshape \seq_item:Nn \g_ecofin_auth_names_seq {#1}}%
        \exp_args:Nx \__ecofin_queue_fn:n { \seq_item:Nn \g_ecofin_auth_notes_seq {#1} }
        \par
        \tl_set:Nx \l_tmpb_tl { \seq_item:Nn \g_ecofin_auth_insts_seq {#1} }
        \tl_if_blank:VF \l_tmpb_tl
          {
            \vspace{0.18em}
            {\small\scshape\color{black!78} \tl_use:N \l_tmpb_tl \par}
          }
      }
  }

\cs_new_protected:Npn \__ecofin_render_author_row:nnn #1 #2 #3
  {
    % #1 = start index, #2 = count in this row (1, 2, or 3), #3 = max cols
    \noindent
    \makebox[\linewidth][c]
      {
        \int_case:nn {#2}
          {
            {1}
              {
                \__ecofin_render_author_cell:nn {#1} { 0.72\linewidth }
              }
            {2}
              {
                \__ecofin_render_author_cell:nn {#1} { 0.45\linewidth }
                \hspace{0.04\linewidth}
                \__ecofin_render_author_cell:nn { \int_eval:n {#1 + 1} } { 0.45\linewidth }
              }
            {3}
              {
                \__ecofin_render_author_cell:nn {#1} { 0.305\linewidth }
                \hspace{0.03\linewidth}
                \__ecofin_render_author_cell:nn { \int_eval:n {#1 + 1} } { 0.305\linewidth }
                \hspace{0.03\linewidth}
                \__ecofin_render_author_cell:nn { \int_eval:n {#1 + 2} } { 0.305\linewidth }
              }
          }
      }
    \par
  }

\cs_new_protected:Npn \__ecofin_render_author_grid:
  {
    \int_set:Nn \l_tmpa_int { \seq_count:N \g_ecofin_auth_names_seq }
    \int_compare:nNnT { \l_tmpa_int } > { 0 }
      {
        \group_begin:
          \int_set:Nn \l_ecofin_saved_fn_int { \value{footnote} }
          \setcounter{footnote}{0}
          \seq_gclear:N \g_ecofin_deferred_notes_seq
          \int_compare:nNnTF { \l_tmpa_int } > { 9 }
            { \renewcommand{\thefootnote}{\arabic{footnote}} }
            { \renewcommand{\thefootnote}{\@fnsymbol{\value{footnote}}} }

          % Acknowledgements and disclosures: unmarked, first among the page-1 footnotes
          \tl_clear:N \l_tmpa_tl
          \bool_if:NT \g_ecofin_showthanks_bool
            {
              \tl_if_empty:NF \g_ecofin_thanks_tl
                {
                  \tl_put_right:NV \l_tmpa_tl \g_ecofin_thanks_tl
                  \tl_put_right:Nn \l_tmpa_tl { ~ }
                }
            }
          \bool_if:NT \g_ecofin_showdisclosure_bool
            {
              \tl_if_empty:NF \g_ecofin_disclosure_tl
                { \tl_put_right:NV \l_tmpa_tl \g_ecofin_disclosure_tl }
            }
          \tl_if_blank:VF \l_tmpa_tl
            { \__ecofin_emit_unmarked_note:n { \tl_use:N \l_tmpa_tl } }

          % Rows of the author block (1, 2, 3, 2+2, 3+2, 3+3)
          \int_set:Nn \l_tmpb_int { 3 }
          \str_case:Vn \g_ecofin_authorcols_tl
            {
              {1} { \int_set:Nn \l_tmpb_int { 1 } }
              {2} { \int_set:Nn \l_tmpb_int { 2 } }
              {3} { \int_set:Nn \l_tmpb_int { 3 } }
              {auto}
                {
                  \int_compare:nNnTF { \l_tmpa_int } = { 4 }
                    { \int_set:Nn \l_tmpb_int { 2 } }
                    { \int_set:Nn \l_tmpb_int { 3 } }
                }
            }

          \int_set:Nn \l_ecofin_idx_int { 1 }
          \bool_while_do:nn { \int_compare_p:n { \l_ecofin_idx_int <= \l_tmpa_int } }
            {
              \int_compare:nNnT { \l_ecofin_idx_int } > { 1 }
                { \vspace{0.95em} }
              \int_set:Nn \l_ecofin_rem_int { \l_tmpa_int - \l_ecofin_idx_int + 1 }
              % Four authors left with three columns: two rows of two, not three and one
              \bool_lazy_and:nnTF
                { \int_compare_p:nNn { \l_tmpb_int } = { 3 } }
                { \int_compare_p:nNn { \l_ecofin_rem_int } = { 4 } }
                { \int_set:Nn \l_ecofin_row_int { 2 } }
                {
                  \int_set:Nn \l_ecofin_row_int
                    { \int_min:nn { \l_tmpb_int } { \l_ecofin_rem_int } }
                }
              \__ecofin_render_author_row:nnn
                { \l_ecofin_idx_int }
                { \l_ecofin_row_int }
                { \l_tmpb_int }
              \int_add:Nn \l_ecofin_idx_int { \l_ecofin_row_int }
            }

          \par\nobreak
          \seq_map_inline:Nn \g_ecofin_deferred_notes_seq {##1}
          \seq_gclear:N \g_ecofin_deferred_notes_seq
          \setcounter{footnote}{ \int_use:N \l_ecofin_saved_fn_int }
        \group_end:
      }
  }
\int_new:N \l_ecofin_idx_int
\int_new:N \l_ecofin_rem_int
\int_new:N \l_ecofin_row_int

\NewDocumentCommand{\ecofinmaketitle}{O{Online~Appendix}}
  {
    \legacy_if:nTF { K@standaloneoa }
      {
        % Standalone online appendix: its own title block, authors optional
        \tl_if_empty:NTF \g_ecofin_subtitle_tl
          { \ecofinstandaloneoatitle[#1]{ \tl_use:N \g_ecofin_title_tl } }
          { \ecofinstandaloneoatitle[#1]{ \tl_use:N \g_ecofin_title_tl }{ \tl_use:N \g_ecofin_subtitle_tl } }
        \legacy_if:nF { K@anonymous }
          {
            \int_compare:nNnT { \seq_count:N \g_ecofin_auth_names_seq } > { 0 }
              {
                \begin{center}
                  {\scshape \seq_use:Nn \g_ecofin_auth_names_seq { ,\space }\par}
                \end{center}
              }
          }
        \tl_if_empty:NF \g_ecofin_date_tl
          {
            \begin{center}
              {\normalsize
                \tl_if_empty:NF \g_ecofin_dateprefix_tl
                  { {\scshape \tl_use:N \g_ecofin_dateprefix_tl}\space }
                \tl_use:N \g_ecofin_date_tl \par}
            \end{center}
            \vspace{0.4em}
          }
      }
      {
        % Working paper, anonymous copy, article and title page
        \thispagestyle{plain}
        \vspace*{-1.4em}
        \begin{center}
          \ecofindisplayfont\bfseries\setstretch{1.1}
          \legacy_if:nTF { K@hugetitle } { \Huge } { \LARGE }
          \tl_use:N \g_ecofin_title_tl \par
          \tl_if_empty:NF \g_ecofin_subtitle_tl
            {
              \vspace{0.35em}
              {\ecofindisplayfont\mdseries\Large\color{black!84} \tl_use:N \g_ecofin_subtitle_tl \par}
            }
        \end{center}

        \legacy_if:nF { K@anonymous }
          {
            \vspace{0.65em}
            \__ecofin_render_author_grid:
          }

        \tl_if_empty:NF \g_ecofin_date_tl
          {
            \vspace{0.65em}
            \begin{center}
              {\normalsize
                \tl_if_empty:NF \g_ecofin_dateprefix_tl
                  { {\scshape \tl_use:N \g_ecofin_dateprefix_tl}\space }
                \tl_use:N \g_ecofin_date_tl \par}
            \end{center}
          }

        \bool_if:NT \g_ecofin_showabstract_bool
          {
            \tl_if_empty:NF \g_ecofin_abstract_tl
              {
                \vspace{0.85em}
                \str_if_eq:VnTF \g_ecofin_abstractstyle_tl { inset }
                  {
                    \begin{list}{}{%
                      \setlength{\leftmargin}{0.045\textwidth}%
                      \setlength{\rightmargin}{0.045\textwidth}%
                      \setlength{\topsep}{0pt}%
                      \setlength{\partopsep}{0pt}%
                      \setlength{\parsep}{0pt}%
                      \setlength{\listparindent}{0pt}%
                    }
                    \item\relax
                    {\setstretch{1.05}\small
                      \begin{center}{\normalsize\scshape Abstract}\end{center}
                      \vspace{0.15em}
                      \justifying\noindent \tl_use:N \g_ecofin_abstract_tl \par
                      \bool_if:nT
                        { \g_ecofin_showkeywords_bool || \g_ecofin_showjel_bool }
                        { \vspace{0.65em} }
                      \bool_if:NT \g_ecofin_showkeywords_bool
                        {
                          \tl_if_empty:NF \g_ecofin_keywords_tl
                            {
                              {\raggedright\noindent\textbf{Keywords:}\space
                                \tl_use:N \g_ecofin_keywords_tl \par}
                              \vspace{0.2em}
                            }
                        }
                      \bool_if:NT \g_ecofin_showjel_bool
                        {
                          \tl_if_empty:NF \g_ecofin_jel_tl
                            {
                              \noindent\textbf{JEL~classification:}\space
                                \tl_use:N \g_ecofin_jel_tl \par
                            }
                        }
                    }
                    \end{list}
                  }
                  {
                    {\setstretch{1}
                      \K@origabstract
                        \noindent \tl_use:N \g_ecofin_abstract_tl
                      \K@origendabstract
                      \medskip
                      \bool_if:NT \g_ecofin_showkeywords_bool
                        {
                          \tl_if_empty:NF \g_ecofin_keywords_tl
                            {
                              {\raggedright\noindent\textbf{Keywords:}\space
                                \tl_use:N \g_ecofin_keywords_tl \par}
                            }
                        }
                      \bool_if:NT \g_ecofin_showjel_bool
                        {
                          \tl_if_empty:NF \g_ecofin_jel_tl
                            {
                              \noindent\textbf{JEL~classification:}\space
                                \tl_use:N \g_ecofin_jel_tl \par
                            }
                        }
                    }
                  }
              }
          }

        % With \maketitle followed by the abstract environment, the environment prints the
        % contents after the abstract; printing them here as well gave them twice.
        \bool_if:nT { \g_ecofin_showtoc_bool && ! \g_ecofin_std_maketitle_pending_bool }
          {
            \vspace{0.8em}
            {\singlespacing\small\tableofcontents}
          }

        \bool_if:NF \g_ecofin_std_maketitle_pending_bool
          {
            \legacy_if:nTF { K@titleonly }
              { \clearpage \end{document} }
              { \newpage }
          }
      }
  }

% \maketitle followed by \begin{abstract}...\end{abstract}
\RenewDocumentEnvironment{abstract}{+b}
  {
    \bool_if:NTF \g_ecofin_std_maketitle_pending_bool
      {
        \bool_gset_false:N \g_ecofin_std_maketitle_pending_bool
        \tl_gset:Nn \g_ecofin_abstract_tl {#1}
        \bool_if:NT \g_ecofin_showabstract_bool
