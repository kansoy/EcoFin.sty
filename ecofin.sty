      }

    % An anonymous copy never shows co-author notes
    \legacy_if:nT { K@anonymous } { \legacy_if_gset_false:n { K@notes } }

    \legacy_if:nT { K@dualbib }
      {
        \legacy_if:nF { K@bibunits }
          {
            \PackageWarningNoLine{ecofin}{dualbib=true~requested~with~nobibunits;~disabling~dualbib}
            \legacy_if_gset_false:n { K@dualbib }
          }
      }

    % 3. Section numbers
    \str_case:Vn \g_ecofin_sections_tl
      {
        {arabic}
          {
            \renewcommand{\thesection}{\arabic{section}}
            \renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
          }
        {roman}
          {
            \renewcommand{\thesection}{\Roman{section}}
            \renewcommand{\thesubsection}{\thesection.\Alph{subsection}}
          }
        {unnumbered}
          { \setcounter{secnumdepth}{0} }
      }

    % 4. Paragraph skip, title size, line numbers
    \legacy_if:nTF { K@tightparskip }
      { \setlength{\parskip}{0pt plus 2pt} }
      { \setlength{\parskip}{0.5\baselineskip} }
    \legacy_if:nTF { K@hugetitle }
      { \renewcommand{\titlesize}{\Huge} }
      { \renewcommand{\titlesize}{\LARGE} }

    % 5. Running heads and draft banner (no author names in an anonymous copy)
    \fancyhead{}
    \legacy_if:nTF { K@draft }
      {
        \fancyhead[C]{\color{gray}\scriptsize\scshape Working~Paper~Draft.~Please~Do~Not~Cite~Without~Permission}
      }
      {
        \str_case:Vn \g_ecofin_runninghead_tl
          {
            {title}
              { \fancyhead[C]{\color{gray}\footnotesize\scshape \tl_use:N \g_ecofin_shorttitle_tl} }
            {authors}
              {
                \legacy_if:nF { K@anonymous }
                  {
                    \fancyhead[C]{\color{gray}\footnotesize\scshape \seq_use:Nn \g_ecofin_auth_names_seq { ,\space }}
                  }
              }
          }
      }

    % 6. "See the latest version at" line on the title page (not in an anonymous copy)
    \bool_if:NT \g_ecofin_avail_set_bool
      {
        \legacy_if:nF { K@anonymous }
          {
            \fancypagestyle{plain}
              {
                \fancyhf{}
                \renewcommand{\headrulewidth}{0pt}
                \fancyfoot[C]{\color{gray}\footnotesize
                  \tl_if_empty:NF \g_ecofin_avail_journal_tl
                    { Published~in~\emph{\tl_use:N \g_ecofin_avail_journal_tl}\;\textbullet\; }
                  See~the~latest~version~at~\exp_args:NV \url \g_ecofin_avail_url_tl
                }
              }
          }
      }

    % 7. \maketitle, and an anonymous copy without names in the text or the PDF details
    \int_compare:nNnTF { \seq_count:N \g_ecofin_auth_names_seq } > { 0 }
      {
        \renewcommand{\maketitle}
          {
            \tl_if_empty:NT \g_ecofin_abstract_tl
              { \bool_gset_true:N \g_ecofin_std_maketitle_pending_bool }
            \ecofinmaketitle
          }
      }
      { }

    \legacy_if:nTF { K@anonymous }
      {
        \int_compare:nNnF { \seq_count:N \g_ecofin_auth_names_seq } > { 0 }
          {
            \preauthor{}
            \postauthor{}
            \renewcommand{\author}[1]{\gdef\@author{}}
            \gdef\@author{}
            \renewcommand{\maketitle}{%
              \begingroup
                \renewcommand{\thanks}[1]{}%
                \let\@thanks\@empty
                \gdef\@author{}%
                \K@origmaketitle
              \endgroup
            }
          }
        \ifdefined\pdfsuppressptexinfo\pdfsuppressptexinfo=15\relax\fi
        \ifluatex\pdfvariable suppressoptionalinfo 512\relax\fi
        \hypersetup{pdfauthor={},pdfcreator={},pdfproducer={}}
        % hyperref (pdfusetitle) keeps its own copy of whatever \author received and
        % writes it into the PDF when pdfauthor is empty. Empty that copy as well.
        \cs_gset:cpn { Hy@author } { }
      }
      {
        \int_compare:nNnT { \seq_count:N \g_ecofin_auth_names_seq } > { 0 }
          {
            \tl_set:Nx \l_tmpa_tl { \seq_use:Nn \g_ecofin_auth_names_seq { ,~ } }
            \exp_args:Nx \hypersetup { pdfauthor = { \exp_not:V \l_tmpa_tl } }
          }
      }

    \tl_if_empty:NF \g_ecofin_title_tl
      {
        \tl_if_empty:NTF \g_ecofin_subtitle_tl
          { \exp_args:Nx \hypersetup { pdftitle = { \exp_not:V \g_ecofin_title_tl } } }
          {
            \exp_args:Nx \hypersetup
              { pdftitle = { \exp_not:V \g_ecofin_title_tl :~ \exp_not:V \g_ecofin_subtitle_tl } }
          }
      }

    % 8. Labels of the other file in a split build
    \legacy_if:nT { K@standaloneoa }
      {
        \IfFileExists{xref/2_manuscript_anonymous.xref.aux}
          { \externaldocument{xref/2_manuscript_anonymous.xref}[2_manuscript_anonymous.pdf] }
          { }
      }
    \bool_if:nT
      { \legacy_if_p:n { K@main } && ! \legacy_if_p:n { K@oa } }
      {
        \IfFileExists{xref/3_online_appendix.xref.aux}
          { \externaldocument{xref/3_online_appendix.xref}[3_online_appendix.pdf] }
          { }
      }
    \legacy_if:nTF { K@oa }      { \legacy_if_gset_true:n { ecofinoa } }      { \legacy_if_gset_false:n { ecofinoa } }
    \legacy_if:nTF { K@dualbib } { \legacy_if_gset_true:n { ecofindualbib } } { \legacy_if_gset_false:n { ecofindualbib } }
  }

