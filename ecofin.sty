% --- named switches for sections and blocks ---
\NewDocumentCommand{\ecofintoggle}{m m}
  {
    \str_case:nnF {#2}
      {
        {true}  { \prop_gput:Nnn \g_ecofin_toggles_prop {#1} {true} }
        {false} { \prop_gput:Nnn \g_ecofin_toggles_prop {#1} {false} }
      }
      { \PackageError{ecofin}{Toggle~`#1'~must~be~true~or~false}{Use~true~or~false.} }
  }

\keys_define:nn { ecofin/cond }
  {
    if .code:n =
      {
        \prop_get:NnNTF \g_ecofin_toggles_prop {#1} \l_ecofin_toggle_val_tl
          {
            \str_if_eq:VnTF \l_ecofin_toggle_val_tl {true}
              { \bool_set_true:N  \l_ecofin_cond_bool }
              { \bool_set_false:N \l_ecofin_cond_bool }
          }
          {
            \bool_set_false:N \l_ecofin_cond_bool
            \PackageError{ecofin}{Unknown~toggle~`#1'}{Declare~it~first~with~\string\ecofintoggle{#1}{true|false}.}
          }
      },
    show .bool_set:N = \l_ecofin_cond_bool,
  }

