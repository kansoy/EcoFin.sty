% Defaults: Geist Serif headings, Source Serif Pro text, Latin Modern maths, working
% paper mode, sections numbered 1. / 1.1, equation numbers on the right, a separate
% reference list for the online appendix, US Letter paper.
\K@tikztrue
\K@geisttitletrue
\K@bibunitstrue
\K@dualbibtrue
\K@maintrue
\K@oatrue
\def\K@paper{letterpaper}
\def\K@mathfont{cm}

\ExplSyntaxOn
\tl_new:N   \g_ecofin_mode_tl
\tl_new:N   \g_ecofin_sections_tl
