            \vspace{0.85em}
            \begin{list}{}{%
              \setlength{\leftmargin}{0.045\textwidth}%
              \setlength{\rightmargin}{0.045\textwidth}%
              \setlength{\topsep}{0pt}%
              \setlength{\partopsep}{0pt}%
              \setlength{\parsep}{0pt}%
              \setlength{\listparindent}{0pt}%
            }
            \item\relax
            {\setstretch{1.05}\small
              \begin{center}{\normalsize\scshape Abstract}\end{center}
              \vspace{0.15em}
              \justifying\noindent #1 \par
              \bool_if:nT { \g_ecofin_showkeywords_bool || \g_ecofin_showjel_bool } { \vspace{0.65em} }
              \bool_if:NT \g_ecofin_showkeywords_bool
                {
                  \tl_if_empty:NF \g_ecofin_keywords_tl
                    { {\raggedright\noindent\textbf{Keywords:}\space \tl_use:N \g_ecofin_keywords_tl \par}\vspace{0.2em} }
                }
              \bool_if:NT \g_ecofin_showjel_bool
                {
                  \tl_if_empty:NF \g_ecofin_jel_tl
                    { \noindent\textbf{JEL~classification:}\space \tl_use:N \g_ecofin_jel_tl \par }
                }
            }
            \end{list}
          }
        \bool_if:NT \g_ecofin_showtoc_bool
          { \vspace{0.8em}{\singlespacing\small\tableofcontents} }
        \legacy_if:nTF { K@titleonly }
          { \AddToHookNext { env/abstract/after } { \clearpage \end{document} } }
          { \newpage }
      }
      {
