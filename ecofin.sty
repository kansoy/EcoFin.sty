% Co-author margin comments and wording proposals (notes = show | hide).
% The text must break into the same lines whether the notes are shown or hidden, so
% nothing printed here takes room in the line: the mark has zero width, the note sits
% in the margin, and the spaces around the command are treated alike in both states.
% Limit: the notes are LaTeX \marginpar's. LaTeX allows a page break after a line that
% carries one, also where the widow and orphan rules would otherwise forbid it, so in a
% text crowded with notes a page break can fall one line earlier or later.
\skip_new:N \l__ecofin_note_skip
\int_new:N  \l__ecofin_note_sf_int

% #1 = colour, #2 = mark (math material), #3 = label, #4 = text of the margin note,
% #5 = r or l: the mark is drawn to the left (r) or to the right (l) of the current
%      point, whichever side has the space, so that it does not sit on a letter
\cs_new_protected:Npn \__ecofin_note_emit:nnnnn #1 #2 #3 #4 #5
  {
    \makebox[0pt][#5]{\smash{\raisebox{0.65ex}{\tiny\color{#1}$#2$}}}%
    \marginpar{%
      \RaggedRight\setstretch{0.96}\scriptsize\color{#1}%
      \textbf{[#3]}\space {\color{black!82}#4}\par
    }%
  }

\cs_new_protected:Npn \__ecofin_note:nnnn #1 #2 #3 #4
  {
    \legacy_if:nTF { K@notes }
      {
        \ifvmode
          % At the start of a paragraph: begin it, as the text that follows would.
          \leavevmode
          \__ecofin_note_emit:nnnnn {#1} {#2} {#3} {#4} { r }
          \exp_after:wN \ignorespaces
        \else
          \@bsphack
          \skip_set:Nn \l__ecofin_note_skip   { \@savsk }
          \int_set:Nn  \l__ecofin_note_sf_int { \@savsf }
          \dim_compare:nNnTF { \l__ecofin_note_skip } > { \c_zero_dim }
            { \__ecofin_note_emit:nnnnn {#1} {#2} {#3} {#4} { r } }
            { \__ecofin_note_emit:nnnnn {#1} {#2} {#3} {#4} { l } }
          \@savsk \l__ecofin_note_skip
          \@savsf \l__ecofin_note_sf_int
          \exp_after:wN \@esphack
        \fi
      }
      { \@bsphack \@esphack }
  }

\NewDocumentCommand{\mnote}{O{Note} +m}
  { \__ecofin_note:nnnn { ecofinwine } { \bullet } {#1} {#2} }

\NewDocumentCommand{\discuss}{O{Discuss} +m}
  { \__ecofin_note:nnnn { ecofinolive } { \blacktriangleright } {#1} {#2} }

% \replace[who]{old wording}{new wording}: the new wording is printed in the text, in
% colour while notes are shown; the old wording goes into the margin.
\NewDocumentCommand{\replace}{O{Edit} +m +m}
  {
    \legacy_if:nTF { K@notes }
      {
        {\color{ecofinblue}#3}%
        \marginpar{%
          \RaggedRight\setstretch{0.96}\scriptsize\color{ecofinblue}%
          \textbf{[#1]}\space {\color{black!82}was:~#2}\par
        }%
      }
      {#3}
  }
