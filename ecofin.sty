      { \prop_gput:Nnn \g_ecofin_affil_addr_prop {#1} {#2} }
  }

% \author[id,*]{Name}; without [id] and \affil it behaves as in plain LaTeX
\cs_set_protected:Npn \author
  { \@ifnextchar [ { \__ecofin_author_opt:w } { \__ecofin_author_plain:n } }
\cs_new_protected:Npn \__ecofin_author_opt:w [#1] #2
  {
    \bool_gset_true:N \g_ecofin_used_structured_bool
    \seq_gput_right:Nn \g_ecofin_std_names_seq  {#2}
    \seq_gput_right:Nn \g_ecofin_std_keys_seq   {#1}
    \seq_gput_right:Nn \g_ecofin_std_emails_seq {}
    \seq_gput_right:Nn \g_ecofin_std_orcids_seq {}
    \seq_gput_right:Nn \g_ecofin_std_notes_seq  {}
  }
\cs_new_protected:Npn \__ecofin_author_plain:n #1
  {
    \tl_if_blank:nTF {#1}
      { \K@origauthor{} }
      {
        \K@origauthor{#1}
        \seq_gput_right:Nn \g_ecofin_std_names_seq  {#1}
        \seq_gput_right:Nn \g_ecofin_std_keys_seq   {1}
        \seq_gput_right:Nn \g_ecofin_std_emails_seq {}
        \seq_gput_right:Nn \g_ecofin_std_orcids_seq {}
        \seq_gput_right:Nn \g_ecofin_std_notes_seq  {}
      }
  }

\cs_new_protected:Npn \__ecofin_set_last_seq:NNn #1 #2 #3
  {
