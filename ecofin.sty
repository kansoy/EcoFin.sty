% 10. Online appendix: counters and link targets
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\AddToHook{cmd/appendix/after}[ecofin]{%
  \renewcommand{\theHtable}{app.\thetable}%
  \renewcommand{\theHfigure}{app.\thefigure}%
  \renewcommand{\theHequation}{app.\theequation}%
  \bookmarksetup{startatroot}%
}
\newcounter{K@appendixblock}

\newcommand{\ecofinappendixsection}[1]{%
  \stepcounter{K@appendixblock}%
  \def\K@appendixletter{#1}%
  \edef\K@appendixanchor{oa.\arabic{K@appendixblock}.#1}%
  \setcounter{table}{0}%
  \setcounter{figure}{0}%
  \setcounter{theorem}{0}%
  \setcounter{proposition}{0}%
  \setcounter{lemma}{0}%
  \setcounter{corollary}{0}%
  \setcounter{definition}{0}%
  \setcounter{assumption}{0}%
  \setcounter{remark}{0}%
  \setcounter{prediction}{0}%
  \renewcommand{\thetable}{#1\arabic{table}}%
  \renewcommand{\thefigure}{#1\arabic{figure}}%
  \renewcommand{\thetheorem}{#1\arabic{theorem}}%
  \renewcommand{\theproposition}{#1\arabic{proposition}}%
  \renewcommand{\thelemma}{#1\arabic{lemma}}%
  \renewcommand{\thecorollary}{#1\arabic{corollary}}%
  \renewcommand{\thedefinition}{#1\arabic{definition}}%
  \renewcommand{\theassumption}{#1\arabic{assumption}}%
  \renewcommand{\theremark}{#1\arabic{remark}}%
  \renewcommand{\theprediction}{#1\arabic{prediction}}%
  \renewcommand{\theHtable}{\K@appendixanchor.table.\arabic{table}}%
  \renewcommand{\theHfigure}{\K@appendixanchor.figure.\arabic{figure}}%
  \renewcommand{\theHtheorem}{\K@appendixanchor.theorem.\arabic{theorem}}%
  \renewcommand{\theHproposition}{\K@appendixanchor.prop.\arabic{proposition}}%
  \renewcommand{\theHlemma}{\K@appendixanchor.lemma.\arabic{lemma}}%
  \renewcommand{\theHcorollary}{\K@appendixanchor.cor.\arabic{corollary}}%
  \renewcommand{\theHdefinition}{\K@appendixanchor.def.\arabic{definition}}%
  \renewcommand{\theHassumption}{\K@appendixanchor.assump.\arabic{assumption}}%
  \renewcommand{\theHremark}{\K@appendixanchor.rem.\arabic{remark}}%
  \renewcommand{\theHprediction}{\K@appendixanchor.pred.\arabic{prediction}}%
  \renewcommand{\theHsection}{\K@appendixanchor.section.\arabic{section}}%
  \renewcommand{\theHsubsection}{\theHsection.\arabic{subsection}}%
  \ifK@appeqreset
    \setcounter{equation}{0}%
    \renewcommand{\theequation}{#1\arabic{equation}}%
    \renewcommand{\theHequation}{\K@appendixanchor.eq.\arabic{equation}}%
  \fi
}

\newcommand{\ecofinappendix}[1][A]{%
  \clearpage
  \appendix
  \ecofinappendixsection{#1}%
}

\ExplSyntaxOn
\NewDocumentCommand{\K@oa@begin}{s O{Online~Appendix} o}
  {
    \bool_if:nTF
      { \IfBooleanTF {#1} { \c_true_bool } { \c_false_bool } || \legacy_if_p:n { K@standaloneoa } }
      {
        \appendix
        \IfValueTF {#3} { \ecofinappendixsection{#3} } { \ecofinappendixsection{A} }
        \bookmarksetup{startatroot}
        \pdfbookmark[0]{#2}{ecofin.oa.root.\arabic{K@appendixblock}}
      }
      {
        \IfValueTF {#3} { \ecofinappendix[#3] } { \ecofinappendix[A] }
        \bookmarksetup{startatroot}
        \pdfbookmark[0]{#2}{ecofin.oa.root.\arabic{K@appendixblock}}
        \section*{#2}
      }
    \bool_if:NT \g_ecofin_showoatoc_bool
      {
        \addtocontents{toc}{\protect\setcounter{tocdepth}{2}}
        {\singlespacing\small\renewcommand{\contentsname}{}\tableofcontents}
        \vspace{0.8em}
      }
    \legacy_if:nT { K@dualbib }
      {
        \edef\K@startbu{\noexpand\begin{bibunit}[\K@bibstyle]}\K@startbu
      }
  }

\cs_new_protected:Npn \K@oa@end:
  {
