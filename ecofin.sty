% Standard LaTeX commands for the front matter.
% \title and \author are defined the classic way on purpose. A document command
% (\RenewDocumentCommand) uses the names "\title " and "\author " (with a trailing
% space) as scratch macros on first use. Those are the names of the LaTeX kernel's
% own inner macros for the robust \title and \author, which \K@origtitle and
% \K@origauthor still call, so the first \title{...} sent TeX into an endless loop.
\cs_set_protected:Npn \title
  { \@ifnextchar [ { \__ecofin_title_opt:w } { \__ecofin_title_plain:n } }
\cs_new_protected:Npn \__ecofin_title_opt:w [#1] #2 { \ecofintitle[#1]{#2} }
\cs_new_protected:Npn \__ecofin_title_plain:n #1 { \ecofintitle{#1} }
\providecommand{\subtitle}{}
\RenewDocumentCommand{\subtitle}{+m}{\ecofinsubtitle{#1}}
\RenewDocumentCommand{\date}{m}{\ecofindate{#1}}
\providecommand{\keywords}{}
\RenewDocumentCommand{\keywords}{+m}{\ecofinkeywords{#1}}
\providecommand{\jel}{}
\RenewDocumentCommand{\jel}{+m}{\ecofinjel{#1}}
\providecommand{\disclosure}{}
\RenewDocumentCommand{\disclosure}{+m}{\ecofindisclosure{#1}}

% \thanks{...} written on its own in the preamble sets the unmarked first-page
% acknowledgement. Inside \title{...} and \author{...}, and after \begin{document},
% \thanks keeps its ordinary LaTeX meaning.
\cs_set_protected:Npn \thanks #1 { \ecofinthanks{#1} }
\AddToHook{begindocument/before}[ecofin/thanks]{\let\thanks\K@origthanks}

% \affil[id]{Short Institution}[Optional Full Department/Street Address]
