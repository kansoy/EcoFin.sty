% Inline draft note (shown only with draft=true and never in an anonymous copy)
\NewDocumentCommand{\ecofinnote}{O{Note} +m}
  {
    \legacy_if:nT { K@draft }
      {
        \legacy_if:nF { K@anonymous }
          {
            {\footnotesize\sffamily\color{brickred}\textbf{[#1:}\space #2\textbf{]}}
