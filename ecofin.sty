\bool_gset_true:N  \g_ecofin_showreaderqa_bool

\keys_define:nn { ecofin }
  {
    % --- options that must be given when the package is loaded ---
    typography .choices:nn =
      { hybrid, geist, sourceserif }
      {
        \str_case:Vn \l_keys_choice_tl
          {
            {hybrid}      { \legacy_if_gset_true:n { K@geisttitle } \legacy_if_gset_false:n { K@geistserif } }
            {geist}       { \legacy_if_gset_true:n { K@geistserif } \legacy_if_gset_false:n { K@geisttitle } }
            {sourceserif} { \legacy_if_gset_false:n { K@geisttitle } \legacy_if_gset_false:n { K@geistserif } }
          }
      },
    typography .usage:n = load,

    geisttitle  .meta:n  = { typography = hybrid },
    geisttitle  .usage:n = load,
    geistserif  .meta:n  = { typography = geist },
    geistserif  .usage:n = load,
    sourceserif .meta:n  = { typography = sourceserif },
    sourceserif .usage:n = load,

    math .choices:nn =
      { cm, latinmodern, stix, libertinus }
      {
        \str_case:Vn \l_keys_choice_tl
          {
            {cm}          { \gdef\K@mathfont{cm} }
            {latinmodern} { \gdef\K@mathfont{cm} }
            {stix}        { \gdef\K@mathfont{stix} }
            {libertinus}  { \gdef\K@mathfont{libertinus} }
          }
      },
    math .usage:n = load,

    eqnum .choices:nn =
      { right, left }
      {
        \str_if_eq:VnTF \l_keys_choice_tl { left }
          { \PassOptionsToPackage{leqno}{amsmath} }
          { \PassOptionsToPackage{reqno}{amsmath} }
      },
    % Load-time only: amsmath fixes the tag side while it loads, so the side must be
    % chosen in \usepackage[eqnum=left]{ecofin} (or \documentclass[leqno]{article}),
    % never later in \ecofinsetup.
    eqnum .usage:n = load,
    reqno .meta:n  = { eqnum = right },
    reqno .usage:n = load,
    leqno .meta:n  = { eqnum = left },
    leqno .usage:n = load,

    notes .choices:nn =
      { show, hide }
      {
        \str_if_eq:VnTF \l_keys_choice_tl { show }
          { \legacy_if_gset_true:n  { K@notes } }
          { \legacy_if_gset_false:n { K@notes } }
      },
    notes   .default:n = show,
    notes   .usage:n   = general,
    nonotes .meta:n    = { notes = hide },
    nonotes .usage:n   = general,

    cleveref .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \legacy_if_gset_true:n  { K@cleveref } }
            {false} { \legacy_if_gset_false:n { K@cleveref } }
          }
          { \PackageError{ecofin}{Invalid~cleveref~value~`#1'}{Use~true~or~false.} }
      },
    cleveref   .default:n = true,
    cleveref   .usage:n   = load,
    nocleveref .meta:n    = { cleveref = false },
    nocleveref .usage:n   = load,

    endfloat .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \legacy_if_gset_true:n  { K@endfloat } }
            {false} { \legacy_if_gset_false:n { K@endfloat } }
          }
          { \PackageError{ecofin}{Invalid~endfloat~value~`#1'}{Use~true~or~false.} }
      },
    endfloat .default:n = true,
    endfloat .usage:n   = load,

    bibunits-backend .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \legacy_if_gset_true:n  { K@bibunits } }
            {false} { \legacy_if_gset_false:n { K@bibunits } }
          }
          { \PackageError{ecofin}{Invalid~bibunits-backend~value~`#1'}{Use~true~or~false.} }
      },
    bibunits-backend .default:n = true,
    bibunits-backend .usage:n   = load,

    bibunits   .meta:n  = { bibunits-backend = true, dualbib = true },
    bibunits   .usage:n = load,
    nobibunits .meta:n  = { bibunits-backend = false, dualbib = false },
    nobibunits .usage:n = load,

    tikz .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \legacy_if_gset_true:n  { K@tikz } }
            {false} { \legacy_if_gset_false:n { K@tikz } }
          }
          { \PackageError{ecofin}{Invalid~tikz~value~`#1'}{Use~true~or~false.} }
      },
    tikz    .default:n = true,
    tikz    .usage:n   = load,
    notikz  .meta:n    = { tikz = false },
    notikz  .usage:n   = load,

    paper .choices:nn =
      { letterpaper, a4paper }
      { \tl_gset_eq:NN \K@paper \l_keys_choice_tl },
    paper       .usage:n = load,
    letterpaper .meta:n  = { paper = letterpaper },
    letterpaper .usage:n = load,
    a4paper     .meta:n  = { paper = a4paper },
    a4paper     .usage:n = load,

    % --- options for \ecofinsetup; the mode names also work as package options ---
    mode .choices:nn =
      { wp, blind, article, blindarticle, titlepage, oa, blindoa }
      { \tl_gset_eq:NN \g_ecofin_mode_tl \l_keys_choice_tl },
    mode    .usage:n = general,
    wp      .meta:n  = { mode = wp },
    wp      .usage:n = general,
    blind   .meta:n  = { mode = blind },
    blind   .usage:n = general,
    article .meta:n  = { mode = article },
    article .usage:n = general,
    oa      .meta:n  = { mode = oa },
    oa      .usage:n = general,

    anonymous .code:n =
      {
        \bool_gset_true:N \g_ecofin_anon_override_set_bool
        \str_case:nnF {#1}
          {
            {true}  { \bool_gset_true:N  \g_ecofin_anon_override_bool \legacy_if_gset_true:n  { K@anonymous } }
            {false} { \bool_gset_false:N \g_ecofin_anon_override_bool \legacy_if_gset_false:n { K@anonymous } }
          }
          { \PackageError{ecofin}{Invalid~anonymous~value~`#1'}{Use~true~or~false.} }
      },
    anonymous .default:n = true,
    anonymous .usage:n   = preamble,

    sections .choices:nn =
      { arabic, roman, unnumbered }
      { \tl_gset_eq:NN \g_ecofin_sections_tl \l_keys_choice_tl },
    sections           .usage:n = preamble,
    romansections      .meta:n  = { sections = roman },
    romansections      .usage:n = preamble,
    unnumberedsections .meta:n  = { sections = unnumbered },
    unnumberedsections .usage:n = preamble,

    dualbib .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \legacy_if_gset_true:n  { K@dualbib } }
            {false} { \legacy_if_gset_false:n { K@dualbib } }
          }
          { \PackageError{ecofin}{Invalid~dualbib~value~`#1'}{Use~true~or~false.} }
      },
    dualbib .default:n = true,
    dualbib .usage:n   = preamble,

    bib .choices:nn =
      { dual, single }
      {
        \str_if_eq:VnTF \l_keys_choice_tl { dual }
          { \legacy_if_gset_true:n  { K@dualbib } }
          { \legacy_if_gset_false:n { K@dualbib } }
      },
    bib .usage:n = preamble,

    appeqreset .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \legacy_if_gset_true:n  { K@appeqreset } }
            {false} { \legacy_if_gset_false:n { K@appeqreset } }
          }
          { \PackageError{ecofin}{Invalid~appeqreset~value~`#1'}{Use~true~or~false.} }
      },
    appeqreset .default:n = true,
    appeqreset .usage:n   = preamble,

    appeq .choices:nn =
      { reset, continue }
      {
        \str_if_eq:VnTF \l_keys_choice_tl { reset }
          { \legacy_if_gset_true:n  { K@appeqreset } }
          { \legacy_if_gset_false:n { K@appeqreset } }
      },
    appeq .usage:n = preamble,

    parskip .choices:nn =
      { half, tight }
      {
        \str_if_eq:VnTF \l_keys_choice_tl { tight }
          { \legacy_if_gset_true:n  { K@tightparskip } }
          { \legacy_if_gset_false:n { K@tightparskip } }
      },
    parskip      .usage:n = preamble,
    halfparskip  .meta:n  = { parskip = half },
    halfparskip  .usage:n = preamble,
    tightparskip .meta:n  = { parskip = tight },
    tightparskip .usage:n = preamble,

    titlesize .choices:nn =
      { large, huge }
      {
        \str_if_eq:VnTF \l_keys_choice_tl { huge }
          { \legacy_if_gset_true:n  { K@hugetitle } }
          { \legacy_if_gset_false:n { K@hugetitle } }
      },
    titlesize .usage:n = preamble,
    hugetitle .meta:n  = { titlesize = huge },
    hugetitle .usage:n = preamble,

    linenumbers .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \legacy_if_gset_true:n  { K@linenumbers } }
            {false} { \legacy_if_gset_false:n { K@linenumbers } }
          }
          { \PackageError{ecofin}{Invalid~linenumbers~value~`#1'}{Use~true~or~false.} }
      },
    linenumbers .default:n = true,
    linenumbers .usage:n   = preamble,

    draft .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \legacy_if_gset_true:n  { K@draft } }
            {false} { \legacy_if_gset_false:n { K@draft } }
          }
          { \PackageError{ecofin}{Invalid~draft~value~`#1'}{Use~true~or~false.} }
      },
    draft .default:n = true,
    draft .usage:n   = preamble,

    authorcolumns .choices:nn =
      { auto, 1, 2, 3 }
      { \tl_gset_eq:NN \g_ecofin_authorcols_tl \l_keys_choice_tl },
    authorcolumns .usage:n = preamble,

    abstractstyle .choices:nn =
      { inset, full }
      { \tl_gset_eq:NN \g_ecofin_abstractstyle_tl \l_keys_choice_tl },
    abstractstyle .usage:n = preamble,

    runninghead .choices:nn =
      { none, title, authors }
      { \tl_gset_eq:NN \g_ecofin_runninghead_tl \l_keys_choice_tl },
    runninghead .usage:n = preamble,

    dateprefix  .tl_gset:N = \g_ecofin_dateprefix_tl,
    dateprefix  .usage:n   = preamble,
    oarefheader .tl_gset:N = \g_ecofin_oarefheader_tl,
    oarefheader .usage:n   = preamble,

    showoa           .bool_gset:N = \g_ecofin_requestoa_bool,
    showoa           .usage:n     = preamble,
    showabstract     .bool_gset:N = \g_ecofin_showabstract_bool,
    showabstract     .usage:n     = preamble,
    showkeywords     .bool_gset:N = \g_ecofin_showkeywords_bool,
    showkeywords     .usage:n     = preamble,
    showjel          .bool_gset:N = \g_ecofin_showjel_bool,
    showjel          .usage:n     = preamble,
    showthanks       .bool_gset:N = \g_ecofin_showthanks_bool,
    showthanks       .usage:n     = preamble,
    showdisclosure   .bool_gset:N = \g_ecofin_showdisclosure_bool,
    showdisclosure   .usage:n     = preamble,
    showdeclarations .bool_gset:N = \g_ecofin_showdeclarations_bool,
    showdeclarations .usage:n     = preamble,
    showtoc          .bool_gset:N = \g_ecofin_showtoc_bool,
    showtoc          .usage:n     = preamble,
    showoatoc        .bool_gset:N = \g_ecofin_showoatoc_bool,
    showoatoc        .usage:n     = preamble,
    showappendix     .bool_gset:N = \g_ecofin_showappendix_bool,
    showappendix     .usage:n     = preamble,
    showreaderqa     .bool_gset:N = \g_ecofin_showreaderqa_bool,
    showreaderqa     .usage:n     = preamble,

    unknown .code:n =
      {
        \PackageError{ecofin}{Unknown~option~`\l_keys_key_str'}
          {Check~\string\usepackage[...]{ecofin}~or~\string\ecofinsetup{...}~keys.}
      }
  }

\ProcessKeyOptions[ecofin]

\NewDocumentCommand{\ecofinsetup}{m}{\keys_set:nn { ecofin } {#1}}
\@onlypreamble\ecofinsetup
\ExplSyntaxOff

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 1. Engine and encoding
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage{iftex}
\ifpdftex
  \input{glyphtounicode}
  \pdfgentounicode=1
  \RequirePackage[T1]{fontenc}
  \def\K@declunicode#1/#2\@nil{\DeclareUnicodeCharacter{#1}{\ensuremath{#2}}}
  \@for\K@upair:=%
    2212/-,00D7/\times,00B2/{}^2,2264/\leq,2265/\geq,2192/\rightarrow,%
    03B1/\alpha,03B2/\beta,03B3/\gamma,03B4/\delta,03B5/\epsilon,%
    03B6/\zeta,03B7/\eta,03B8/\theta,03B9/\iota,03BA/\kappa,%
    03BB/\lambda,03BC/\mu,03BD/\nu,03BE/\xi,03BF/o,03C0/\pi,%
    03C1/\rho,03C2/\varsigma,03C3/\sigma,03C4/\tau,03C5/\upsilon,%
    03C6/\phi,03C7/\chi,03C8/\psi,03C9/\omega,0394/\Delta%
  \do{\expandafter\K@declunicode\K@upair\@nil}
  \ifK@geistserif
    \PackageInfo{ecofin}{Option `geistserif' uses OpenType fonts under LuaLaTeX/XeLaTeX; using Source Serif Pro fallback under pdfLaTeX}%
    \K@geistseriffalse
  \fi
  \ifK@geisttitle
    \PackageInfo{ecofin}{Option `geisttitle' uses OpenType fonts under LuaLaTeX/XeLaTeX; using Source Serif Pro fallback under pdfLaTeX}%
    \K@geisttitlefalse
  \fi
\fi

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 2. Text and maths fonts
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\ecofindisplayfont}{}
\newcommand{\K@tabnums}{}

\iftutex
  \RequirePackage{amsmath}
  \RequirePackage{mathtools}
  \RequirePackage{amsthm}
  \RequirePackage{fontspec}
  \RequirePackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
  \newcommand{\K@loadsourceserifmain}{%
    \setmainfont{SourceSerifPro}[
      Ligatures=TeX,
      Extension=.otf,
      UprightFont=*-Regular,
      BoldFont=*-Bold,
      ItalicFont=*-RegularIt,
      BoldItalicFont=*-BoldIt,
      SmallCapsFont=*-Regular,
      SmallCapsFeatures={Letters=SmallCaps}
    ]%
    \renewcommand{\K@tabnums}{\rmfamily\addfontfeatures{Numbers={Lining,Tabular}}}%
  }
  \newcommand{\K@setgeistmain}[2]{%
    \setmainfont{#1}[
      #2
      Ligatures=TeX,
      AutoFakeBold=2.2,
      AutoFakeSlant=0.16,
      Numbers=Lining
    ]%
    \newfontfamily\K@geisttabfont{#1}[
      #2
      Ligatures=TeX,
      AutoFakeBold=2.2,
      AutoFakeSlant=0.16,
      Numbers={Tabular,Lining}
    ]%
    \newfontfamily\K@scfamily{SourceSerifPro}[
      Extension=.otf,
      UprightFont=*-Regular,
      BoldFont=*-Bold,
      SmallCapsFont=*-Regular,
      SmallCapsFeatures={Letters=SmallCaps}
    ]%
    \DeclareRobustCommand{\scshape}{\K@scfamily\addfontfeatures{Letters=SmallCaps}}%
    \let\sc\scshape
    \renewcommand{\K@tabnums}{\K@geisttabfont}%
  }
  \newcommand{\K@setgeisthead}[2]{%
    \newfontfamily\K@geistheadfont{#1}[
      #2
      Ligatures=TeX,
      AutoFakeBold=2.0,
      AutoFakeSlant=0.16
    ]%
    \renewcommand{\ecofindisplayfont}{\K@geistheadfont}%
  }

  \newcommand{\K@geistfontdir}{}
  \newcommand{\K@findfontdir}[1]{%
    \def\K@geistfontdir{}%
    \IfFileExists{./fonts/#1}{%
      \def\K@geistfontdir{./fonts/}%
    }{%
      \IfFileExists{../fonts/#1}{%
        \def\K@geistfontdir{../fonts/}%
      }{%
        \IfFileExists{../../fonts/#1}{%
          \def\K@geistfontdir{../../fonts/}%
        }{}%
      }%
    }%
  }

  \newcommand{\K@geisthb}{}
  \ifluatex
    \def\K@geisthb{Renderer=HarfBuzz,}%
  \fi

  \ifK@geistserif
    \K@findfontdir{GeistSerif-Regular.ttf}%
    \ifx\K@geistfontdir\@empty
      \IfFontExistsTF{Geist Serif}{%
        \edef\K@do@geistmain{\noexpand\K@setgeistmain{Geist Serif}{\K@geisthb}}%
        \K@do@geistmain
      }{%
        \PackageWarningNoLine{ecofin}{Geist Serif font not found; falling back to Source Serif Pro}%
        \K@loadsourceserifmain
      }%
    \else
      \edef\K@do@geistmain{\noexpand\K@setgeistmain{GeistSerif-Regular.ttf}{Path=\K@geistfontdir,\K@geisthb}}%
      \K@do@geistmain
    \fi
  \else
    \K@loadsourceserifmain
    \ifK@geisttitle
      \K@findfontdir{GeistSerif-Regular.ttf}%
      \ifx\K@geistfontdir\@empty
        \ifluatex
          \K@findfontdir{GeistSerif-Variable.ttf}%
          \ifx\K@geistfontdir\@empty
            \IfFontExistsTF{Geist Serif}{%
              \K@setgeisthead{Geist Serif}{Renderer=HarfBuzz,}%
            }{%
              \PackageWarningNoLine{ecofin}{Geist Serif font not found; using Source Serif Pro headings}%
            }%
          \else
            \edef\K@do@geisthead{\noexpand\K@setgeisthead{GeistSerif-Variable.ttf}{Path=\K@geistfontdir,}}%
            \K@do@geisthead
          \fi
        \else
          \IfFontExistsTF{Geist Serif}{%
            \K@setgeisthead{Geist Serif}{}%
          }{%
            \PackageWarningNoLine{ecofin}{Geist Serif font not found; using Source Serif Pro headings}%
          }%
        \fi
      \else
        \edef\K@do@geisthead{\noexpand\K@setgeisthead{GeistSerif-Regular.ttf}{Path=\K@geistfontdir,\K@geisthb}}%
        \K@do@geisthead
      \fi
    \fi
  \fi

  \setmonofont{SourceCodePro}[
    Extension=.otf,
    UprightFont=*-Regular,
    BoldFont=*-Bold,
    ItalicFont=*-RegularIt,
    Scale=MatchLowercase
  ]

  % OpenType maths font (default: Latin Modern Math)
  \def\K@tmpcm{cm}%
  \def\K@tmpstix{stix}%
  \ifx\K@mathfont\K@tmpcm
    \setmathfont{latinmodern-math.otf}%
  \else
    \ifx\K@mathfont\K@tmpstix
      \setmathfont{STIXTwoMath-Regular.otf}%
    \else
      \setmathfont{LibertinusMath-Regular.otf}%
    \fi
  \fi
  \DeclareRobustCommand{\bm}[1]{\symbfit{#1}}%
  \renewcommand{\boldsymbol}[1]{\symbfit{#1}}%
\else
  \providecommand{\hmmax}{0}%
  \providecommand{\bmmax}{2}%
  \def\K@tmpcm{cm}%
  \def\K@tmpstix{stix}%
